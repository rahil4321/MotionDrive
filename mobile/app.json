{
  "expo": {
    "name": "MotionDrive",
    "slug": "motiondrive-controller",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "motiondrive",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.rahil4321.motiondrive",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070A12"
      }
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "MotionDrive uses motion sensors to steer the racing game."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "8f6863f9-9f18-4aba-bf5e-f6a5dd1dec7f"
      }
    }
  }
}
